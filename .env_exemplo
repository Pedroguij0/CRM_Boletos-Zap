# === CONFIGURAÇÕES DA WEB API DA META (WHATSAPP) ===
# Token de acesso permanente do usuário do sistema da Meta
META_TOKEN="INSIRA_SEU_TOKEN_AQUI"

# ID do número de telefone de teste/produção do WhatsApp no Facebook Developers
META_PHONE_ID="INSIRA_SEU_PHONE_ID_AQUI"

# === CONFIGURAÇÃO DO WEBHOOK (VERIFY TOKEN) ===
# A senha de verificação que você inventou e que também configurou no painel da Meta
TOKEN_AQUI="boletoszap_verify_token"

# === CONFIGURAÇÕES DO FLASK ===
# Chave secreta de sessão usada para encriptação interna do Flask
FLASK_SECRET_KEY="boletoszap_secret_key_123"
